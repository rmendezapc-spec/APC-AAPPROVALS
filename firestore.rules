rules_version = '2';

// Reference copy of the security rules for the apc-approvals Firestore project.
// This repo has no Firebase CLI/deploy pipeline (see BUILDHANDOFF.md §7) — paste
// this into Firebase Console -> Build -> Firestore Database -> Rules tab manually.
//
// Requires an authenticated Firebase session. As of the Microsoft sign-in
// rollout there are now TWO kinds of session that satisfy `request.auth !=
// null` below, and this predicate does not yet distinguish between them:
//   1. A real Microsoft/Entra ID session (primary login path, index.html and
//      sales-report.html both offer "Sign in with Microsoft") — a genuine,
//      verified identity tied to an @americanprecast.com account.
//   2. An anonymous session (PIN-login fallback, kept so nobody is locked out
//      if Microsoft sign-in has an issue) — anyone who loads the app still
//      gets one of these automatically and it's just as privileged here.
// In other words: this is still a real barrier against a bare curl/API call
// with just the (public, unavoidably visible) project config, but NOT yet a
// barrier that tells apart "signed in with a verified company identity" from
// "clicked through the anonymous fallback." Tightening every match block
// below the same way would close that gap fully — but only do that once the
// PIN fallback is retired, since it would otherwise lock out anyone still
// using it for everyday app usage (viewing/editing deals, the Sales Report).
//
// ROUND 1 (this pass) tightens just the `users` collection ahead of that —
// see its own match block below for why: it's the one place a client-side-
// only check was a real privilege-escalation hole (anyone could otherwise
// grant themselves 'admin' with a raw Firestore write), and unlike everyday
// deal/report usage, managing user accounts is reasonable to require a real
// identity for even before the PIN fallback is fully retired elsewhere.
//
// Requires BOTH the "Anonymous" AND "Microsoft" sign-in providers enabled in
// Firebase Console -> Build -> Authentication -> Sign-in method. The
// Microsoft provider needs an Application (client) ID + secret from an Azure
// Entra ID app registration (single-tenant, restricted to the American
// Precast Concrete tenant) — see the app's own chat/setup history for the
// exact walkthrough. Without "Anonymous" enabled, signInAnonymously() fails
// and the app falls back to showing its usual storage-error banner.
service cloud.firestore {
  match /databases/{database}/documents {
    // ROUND 1 of tightening (see the note above): the `users` collection is
    // the one place a client-side-only check was a real privilege-escalation
    // hole — the app's role gating (isAdminUser/canAddDeals) only controls
    // what buttons render, so anyone with dev tools open could otherwise
    // call the same Firestore write directly and grant themselves 'admin'.
    // These two helpers require a REAL Microsoft-verified identity (an
    // anonymous PIN-fallback session has no email claim and always fails
    // both) — deliberately narrower than the `request.auth != null` used
    // everywhere else in this file for now. Emails are hardcoded here rather
    // than looked up from the `users` collection itself, since Firestore
    // Rules can only `get()` a known document path and these `users` docs
    // are keyed by an app-generated id (e.g. 'usr_richard'), not by Firebase
    // Auth uid or email — there's no query path from "the caller's verified
    // email" to "their own doc" otherwise. Keep this list in sync with
    // Manage Users' admin/approver accounts by hand (no deploy pipeline —
    // see BUILDHANDOFF.md §7 — so this always needs a manual re-paste here
    // when the admin/approver roster changes).
    function isAdminOrApproverEmail() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower() in [
          'richard@americanprecast.com',
          'navid@americanprecast.com',
          'sandy@americanprecast.com',
          'connor@americanprecast.com'
        ];
    }
    // Self-service "Change Password": lets a signed-in Microsoft user update
    // ONLY the `pin` field of their own account doc (matched by their
    // verified email against the doc's stored `email`, since again there's
    // no uid-keyed lookup available). `affectedKeys().hasOnly(['pin'])`
    // blocks using this same path to sneak in a `role` or `email` change on
    // your own account.
    function isSelfPinChange() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && resource != null
        && resource.data.email is string
        && request.auth.token.email.lower() == resource.data.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin']);
    }

    // Legacy single-document store (superseded by the `deals` collection
    // below), kept only so the one-time migration read still works.
    match /apcDealBoard/{document=**} {
      allow read, write: if request.auth != null;
    }
    // One document per deal.
    match /deals/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Login accounts (name, email, PIN, role, approver slot). The `email`
    // field is what Microsoft sign-in matches a signed-in account against.
    // Reads stay open (the login gate needs the whole roster before it can
    // know who's an admin) — see the residual plaintext-PIN-read gap noted
    // in BUILDHANDOFF.md §6. Writes now require a real Microsoft-verified
    // admin/approver, or a self-service PIN-only change on your own account
    // — this means the PIN-fallback path can no longer manage users or
    // change its own password; the client hides those UI paths accordingly
    // when not signed in via Microsoft (see index.html's isMicrosoftAuthed).
    match /users/{document} {
      allow read: if request.auth != null;
      allow create, delete: if isAdminOrApproverEmail();
      allow update: if isAdminOrApproverEmail() || isSelfPinChange();
    }
    // Reusable proposal boilerplate (scope of work, terms, exclusions, etc.)
    match /templates/{document=**} {
      allow read, write: if request.auth != null;
    }
    // App-wide settings, e.g. Material Calculator per-LF base prices.
    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Per-user inbox notifications (Proposal/Handoff/Engineering assignments).
    match /notifications/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Shared cost code library, attached to line items on the Cost Breakdown.
    match /costCodes/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Saved Cost Breakdown structures (e.g. "Main Template") applied when a
    // rep starts a new deal.
    match /dealTemplates/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Sales Report (sales-report.html) — new months added via its Upload tab.
    match /salesReportUploads/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Sales Report — manually logged cash-collection entries.
    match /salesReportCollections/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Sales Report — per-month/per-deal manual overrides (Commission,
    // Freight, Tax, Collected, Material Type) and the shared tab layout
    // (keyed '__tabConfig').
    match /salesReportOverrides/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
