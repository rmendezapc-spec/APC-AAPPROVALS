rules_version = '2';

// Reference copy of the security rules for the apc-approvals Firestore project.
// This repo has no Firebase CLI/deploy pipeline (see BUILDHANDOFF.md §7) — paste
// this into Firebase Console -> Build -> Firestore Database -> Rules tab manually.
//
// Requires an authenticated Firebase session (the app signs in anonymously on
// load — see the module script in index.html). This is a real access barrier:
// a plain curl/API call with just the project config (which is public and
// unavoidably visible in the page source) no longer gets in — it has to
// establish a Firebase Auth session first. It does NOT distinguish which app
// user is making the request (that's still the client-side name+PIN check in
// index.html, a deterrent rather than real security) — anyone who loads the
// real app still gets an anonymous session and full read/write access to
// everything below. Revisit with real per-person Firebase Auth accounts if
// that finer-grained boundary is needed later.
//
// Requires the "Anonymous" sign-in provider enabled in Firebase Console ->
// Build -> Authentication -> Sign-in method. Without it, signInAnonymously()
// fails and the app falls back to showing its usual storage-error banner.
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy single-document store (superseded by the `deals` collection
    // below), kept only so the one-time migration read still works.
    match /apcDealBoard/{document=**} {
      allow read, write: if request.auth != null;
    }
    // One document per deal.
    match /deals/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Login accounts (name, PIN, role, approver slot).
    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
